<Window x:Class="StartTime.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StartTime"
        Icon="Assets/AppIcon.ico"
        Height="150" Width="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown">
    <Border Background="#1F2937" CornerRadius="10" BorderBrush="#3B82F6" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="3" Opacity="0.45"/>
        </Border.Effect>
        <Grid Margin="16,12,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="EARLIEST EVENT TODAY"
                       FontSize="11" FontWeight="Bold" Foreground="#60A5FA"
                       VerticalAlignment="Center"/>
            <Button Grid.Row="0" Grid.Column="1" x:Name="CloseButton" Content="&#x2715;"
                    Width="24" Height="24" Padding="0" Background="Transparent"
                    BorderThickness="0" Foreground="#9CA3AF" FontSize="13"
                    Cursor="Hand" Click="CloseButton_Click" ToolTip="Close (ends StartTime)"/>

            <TextBlock x:Name="TimestampText" Grid.Row="1" Grid.ColumnSpan="2"
                       Text="Scanning..."
                       FontSize="52" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center"/>

            <TextBlock x:Name="UpdateText" Grid.Row="2" Grid.ColumnSpan="2"
                       Text="" FontSize="11" FontWeight="SemiBold" Foreground="#34D399"
                       HorizontalAlignment="Center" Margin="0,4,0,0"
                       Visibility="Collapsed" Cursor="Hand"
                       MouseLeftButtonUp="UpdateText_MouseLeftButtonUp"/>
        </Grid>
    </Border>
</Window>
